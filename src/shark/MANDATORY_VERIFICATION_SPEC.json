{
  "build": "slop-removal-engine",
  "version": "1.0.0",
  "created": "2026-06-02T20:00:00Z",
  "engineConfig": {
    "requireAllCritical": true,
    "requireAllHigh": true,
    "minPassRate": 0.90,
    "minMechanicalRatio": 0.90,
    "hardFirstPositionThreshold": 0.25,
    "hardFirstDeliverableIds": ["SRE-001", "SRE-002"]
  },
  "deliverables": [
    {
      "id": "SRE-001",
      "name": "SlopRemovalEngine class with all 6 levels",
      "severity": "CRITICAL",
      "reason": "Primary deliverable — the entire engine",
      "level0": {
        "file": "src/slop-removal-engine.ts",
        "minTotalLines": 400,
        "requiredExports": ["SlopRemovalEngine"],
        "requiredMethods": [
          "auditSourcePresence", "auditCallSites",
          "generateScaffoldFor", "executeScaffold",
          "snapshotFilesystem", "compareFilesystem",
          "auditPrinciples", "detectDerailments",
          "enforceHardFirst", "detectE10Violation",
          "measureMechanicalRatio", "writeSreEvidence",
          "validateDeliverable", "evaluateShipGate"
        ],
        "mustNotContain": ["TODO", "FIXME", "placeholder", "stub", "implement later"]
      },
      "level1": {
        "requiredCallSites": [
          {"method": "auditSourcePresence", "minCallersTotal": 1, "mustBeCalledWithinClass": true},
          {"method": "auditCallSites", "minCallersTotal": 1},
          {"method": "evaluateShipGate", "minCallersTotal": 1}
        ]
      }
    },
    {
      "id": "SRE-002",
      "name": "SRE integration points (no dead code)",
      "severity": "CRITICAL",
      "reason": "Engine must be called from runtime entry point",
      "level1": {
        "requiredCallSites": [
          {"method": "SlopRemovalEngine", "callerFile": "src/index.ts", "minCalls": 1},
          {"method": "SlopRemovalEngine", "callerFile": "src/tools/*", "minCalls": 1},
          {"instance": "sre", "minCallersTotal": 1}
        ]
      }
    },
    {
      "id": "SRE-003",
      "name": "MVS spec hash integrity",
      "severity": "CRITICAL",
      "reason": "Tamper protection for verification spec",
      "level3": {
        "fileCheck": {
          "path": "CONTEXT_MANAGEMENT/SRE_HASH.txt",
          "minBytes": 64,
          "contentPattern": "^[a-f0-9]{64}$"
        }
      },
      "level2": {
        "testCases": [
          {
            "name": "SRE verifies MVS hash",
            "setup": "const fs = require('fs'); const crypto = require('crypto');",
            "checks": [
              {"assert": "fs.existsSync('MANDATORY_VERIFICATION_SPEC.json')", "expected": true},
              {"assert": "fs.existsSync('CONTEXT_MANAGEMENT/SRE_HASH.txt')", "expected": true}
            ]
          }
        ]
      }
    },
    {
      "id": "SRE-004",
      "name": "All 6 levels produce correct evidence files",
      "severity": "HIGH",
      "reason": "Evidence system must be complete",
      "level3": {
        "directory": ".spider-v2/sre-evidence",
        "requiredFiles": [
          "SRE_LEVEL0_PRESENCE.json",
          "SRE_LEVEL1_CALLSITE.json",
          "SRE_LEVEL2_EXECUTION.json",
          "SRE_LEVEL3_SIDEEFFECT.json",
          "SRE_LEVEL4_PRINCIPLES.json",
          "SRE_LEVEL5_DERAILMENT.json",
          "SRE_MECHANICAL_RATIO.json",
          "SRE_SHIP_GATE_VERDICT.json"
        ]
      }
    },
    {
      "id": "SRE-005",
      "name": "Hard-first enforcement blocks wrong-order tests",
      "severity": "HIGH",
      "reason": "Prevents agent from testing easy stuff first",
      "level2": {
        "testCases": [
          {
            "name": "Hard-first rejects easy-first test file",
            "actions": [
              {"call": "sre.enforceHardFirst(easyFirstTestContent)", "expectContains": "REJECT"}
            ]
          },
          {
            "name": "Hard-first passes hard-first test file",
            "actions": [
              {"call": "sre.enforceHardFirst(hardFirstTestContent)", "expectContains": "COMPLIANT"}
            ]
          }
        ]
      }
    },
    {
      "id": "SRE-006",
      "name": "E10 detection works",
      "severity": "HIGH",
      "reason": "Agent self-declaration is P0 offense",
      "level2": {
        "testCases": [
          {
            "name": "E10 detects forbidden phrase",
            "actions": [
              {"call": "sre.detectE10Violation('this is runtime grade verified')", "expectKey": "violation", "expectValue": true}
            ]
          },
          {
            "name": "E10 allows clean output",
            "actions": [
              {"call": "sre.detectE10Violation('Container test results show 65/65 passing')", "expectKey": "violation", "expectValue": false}
            ]
          }
        ]
      }
    },
    {
      "id": "SRE-007",
      "name": "SRE passes its own Level 4 (P1-P12)",
      "severity": "HIGH",
      "reason": "Enforcer must not violate principles it enforces",
      "level4": {
        "minimumPassed": 11,
        "totalPrinciples": 12
      }
    },
    {
      "id": "SRE-008",
      "name": "90/10 ratio measurement works",
      "severity": "HIGH",
      "reason": "Engine must self-audit its own composition",
      "level2": {
        "testCases": [
          {
            "name": "Ratio correctly classifies mechanical vs textual",
            "actions": [
              {"call": "sre.measureMechanicalRatio(testRecords)", "expectKey": "ratio", "expectType": "number"}
            ]
          }
        ]
      }
    },
    {
      "id": "SRE-009",
      "name": "Ship gate produces correct verdict",
      "severity": "HIGH",
      "reason": "Ship gate is the final certification",
      "level2": {
        "testCases": [
          {
            "name": "Ship gate rejects when not all pass",
            "actions": [
              {"call": "sre.evaluateShipGate(failingResults)", "expectKey": "overallPassed", "expectValue": false}
            ]
          },
          {
            "name": "Ship gate passes when all pass",
            "actions": [
              {"call": "sre.evaluateShipGate(passingResults)", "expectKey": "overallPassed", "expectValue": true}
            ]
          }
        ]
      }
    }
  ]
}
